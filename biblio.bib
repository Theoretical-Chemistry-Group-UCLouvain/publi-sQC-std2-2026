@article{Kebabsa2026sTDNanoClusters,
	author = {Abir Kebabsa  and Rilinda Plakaj  and Merrine Samy  and Pierpaolo D’Antoni  and François Maurel  and Mauro Stener  and Eric Brémond },
	title = {Simplified Time-Dependent Density-Functional Theory for Noble Metal Nanoclusters: Progress Toward the Tamm–Dancoff Approximation},
	journal = {ChemRxiv},
	volume = {2026},
	number = {0504},
	pages = {},
	year = {2026},
	doi = {10.26434/chemrxiv.15002665/v1},
	URL = {https://chemrxiv.org/doi/abs/10.26434/chemrxiv.15002665/v1},
	eprint = {https://chemrxiv.org/doi/pdf/10.26434/chemrxiv.15002665/v1},
	abstract = {We investigate the optical and plasmonic properties of noble metal nanoclusters containing a few hundred atoms using the simplified TDDFT framework. Compared with full sTDDFT, we find that the Tamm–Dancoff approximation underestimates plasmonband intensities and systematically blue-shifts resonance energies, although it preserves the overall spectral shape in the 2–5 eV range while offering lower computational cost. Building on our previous work [J. Phys. Chem. C 2023, 127, 7718], we further confirm that global and range-separated hybrid functionals are required for an accurate description of plasmon resonances. Benchmarking against polTDDFT shows that sTDDFT offers an efficient and reliable alternative, whereas polTDDFT remains the reference method for describing collective excitations in large noble metal nanoclusters.}
}

